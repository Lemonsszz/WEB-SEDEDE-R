# ---------------------------------------------------------------------------
# Variables de entorno del frontend (Next.js 16)
#
# Copiar a `.env.local` en desarrollo: `cp .env.example .env.local`
# En producción, se definen en el panel del hosting (Vercel/Netlify) o en el
# servidor. NO se suben al repositorio.
# ---------------------------------------------------------------------------

# URL base de la API para el SERVIDOR (Server Components / render en servidor).
# Debe incluir el sufijo /api. La app concatena el recurso: {API_URL}/noticias
API_URL=http://127.0.0.1:8000/api

# URL base de la API para el NAVEGADOR (login y panel administrativo).
# Debe ser pública y alcanzable desde el equipo del usuario.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# URL pública del sitio. Se usa como metadataBase para las etiquetas OpenGraph,
# las URLs canónicas y las imágenes de redes sociales.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
